  actualizado_en    DateTime            @default(now()) @db.Timestamptz(6)
  carrito_items     carrito_items[]
  imagenes_producto imagenes_producto[]
  pedido_items      pedido_items[]
  reservas_stock    reservas_stock[]
  variante_opciones variante_opciones[]
  productos         productos           @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tiendas           tiendas             @relation(fields: [tienda_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([producto_id])
  @@index([tienda_id])
  @@schema("public")
}

