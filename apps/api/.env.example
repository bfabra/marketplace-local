PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://marketplace_dev:TU_CLAVE@localhost:5432/marketplace_db"
JWT_SECRET="cambia_esto_por_un_secreto_largo"
# Origen de la web, para CORS y para armar los enlaces de los correos.
WEB_ORIGIN="http://localhost:3001"
# REDIS_URL="redis://localhost:6379"

# Ingresar con Google (opcional). Google Cloud Console → APIs y servicios →
# Credenciales → ID de cliente OAuth "Aplicación web", con origen autorizado
# http://localhost:3001 (y el dominio real en producción).
# GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"

# Importar el local desde Google Maps (opcional). Clave de API con
# "Places API (New)" habilitada y restringida a esa API. Tiene costo por uso.
# GOOGLE_MAPS_API_KEY=""

# Correo saliente para recuperar la contraseña (opcional en desarrollo: sin
# SMTP_HOST el enlace se muestra en la consola del API).
# SMTP_HOST="smtp.tu-proveedor.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="Tu Comercio Local <no-responder@tucomerciolocal.com>"

# Fotos en Supabase Storage (obligatorio en producción / Render). Sin esto,
# las imágenes van a apps/api/uploads (válido solo en desarrollo local).
# Project Settings → API → Project URL y service_role (secret).
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
